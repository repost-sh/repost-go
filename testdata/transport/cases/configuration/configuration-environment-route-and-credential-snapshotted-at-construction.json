{
  "caseId": "configuration-environment-route-and-credential-snapshotted-at-construction",
  "category": "configuration",
  "description": "REPOST_API_URL and REPOST_SEND_API_KEY are snapshotted once at construction; mutating both process variables before send changes neither the canonical endpoint path nor the Authorization credential.",
  "input": {
    "profile": "valid",
    "env": {
      "REPOST_SEND_API_KEY": "initial-env-key",
      "REPOST_API_URL": "http://localhost:4323/initial"
    }
  },
  "options": {
    "idempotencyKey": "idem_env_snapshot"
  },
  "script": [
    {
      "actor": "runner",
      "action": "mutateEnvironmentAfterConstruction"
    },
    {
      "actor": "fixture",
      "action": "acceptRequest",
      "attempt": 1,
      "assertions": [
        "authorization-octets-preserved"
      ]
    },
    {
      "actor": "fixture",
      "action": "respond",
      "attempt": 1,
      "status": 202,
      "headers": {
        "content-type": "application/json"
      },
      "body": {
        "asset": "validIdentity"
      }
    },
    {
      "actor": "runner",
      "action": "drainRuntimeDiagnostics"
    }
  ],
  "expected": {
    "configurationTrace": [
      "credential:REPOST_SEND_API_KEY",
      "base-url:REPOST_API_URL",
      "endpoint-path:/initial/v1/messages",
      "redirects:false",
